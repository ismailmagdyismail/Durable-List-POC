      "updated": 1,
      "link": null,
      "locked": false,
      "text": "WRITE-AHEAD LOG (WAL)\n\nAppend records:\n• BEGIN Tx_1\n• Node updates\n• COMMIT Tx_1\n\nDurability boundary:\nCOMMIT record reaches stable storage\nbefore success is acknowledged.",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "WRITE-AHEAD LOG (WAL)\n\nAppend records:\n• BEGIN Tx_1\n• Node updates\n• COMMIT Tx_1\n\nDurability boundary:\nCOMMIT record reaches stable storage\nbefore success is acknowledged.",
      "autoResize": true,
      "lineHeight": 1.25
    },
