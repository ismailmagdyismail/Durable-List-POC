      "link": null,
      "locked": false,
      "text": "TRANSACTION CONTEXT\n\nTx_1\n• Read / write set\n• Node changes\n• Commit / abort state\n\nExample:\nSET node_1.next = X\nSET node_2.prev = Y",
      "fontSize": 17,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": null,
      "originalText": "TRANSACTION CONTEXT\n\nTx_1\n• Read / write set\n• Node changes\n• Commit / abort state\n\nExample:\nSET node_1.next = X\nSET node_2.prev = Y",
      "autoResize": true,
      "lineHeight": 1.25
