      "updated": 1792576504219,
      "link": null,
      "locked": false,
      "text": "HAVE TO COORDINATE BETWEEN\nCACHE AND BG-Sync \nso that dirty pages beign flushed\nare not to be partial written to\nheap-storage\npartial state may be re-read by\ncache if requested agai, and flush is\nnot finished",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HAVE TO COORDINATE BETWEEN CACHE AND BG-Sync \nso that dirty pages beign flushed are not to be partial written to heap-storage\npartial state may be re-read by cache if requested agai, and flush is not finished",
      "autoResize": false,
      "lineHeight": 1.25
    },
