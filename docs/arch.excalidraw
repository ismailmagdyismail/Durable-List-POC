      "seed": 2103464761,
      "version": 2846,
      "versionNonce": 1542821130,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792671351860,
      "link": null,
      "locked": false,
      "text": "- flush write buffer writes\n- defines 2 Contracts\n    * will block if we try to set\nmemtable to flush, while in process\nof flushing an exisiting one\n    * opeartes in bg thread\n    * immutable\n    * policy of how, where to flush\nis pluggable",
      "fontSize": 20.529218137450925,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- flush write buffer writes\n- defines 2 Contracts\n    * will block if we try to set memtable to flush, while in process of flushing an exisiting one\n    * opeartes in bg thread\n    * immutable\n    * policy of how, where to flush is pluggable",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZIynVtm5g6xs5-iazHKTS",
      "type": "text",
      "x": 2151.3394470164294,
      "y": 2416.2269525339657,
      "width": 358.5646702997364,
      "height": 201.84759369749415,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0E",
      "roundness": null,
      "seed": 541295641,
      "version": 2676,
      "versionNonce": 1062364106,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792671351860,
      "link": null,
      "locked": false,
      "text": "HAVE TO COORDINATE BETWEEN\nCACHE AND BG-Flusher \n- so that dirty pages beign flushed\nare not to be partial written to\nheap-storage\n- partial state may be re-read by\ncache if requested agai, and flush is\nnot finished",
      "fontSize": 20.184759369749415,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HAVE TO COORDINATE BETWEEN CACHE AND BG-Flusher \n- so that dirty pages beign flushed are not to be partial written to heap-storage\n- partial state may be re-read by cache if requested agai, and flush is not finished",
      "autoResize": false,
      "lineHeight": 1.25
    },
