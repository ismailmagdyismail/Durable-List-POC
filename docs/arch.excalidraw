    {
      "id": "pbrF0q14i78WT-ai5sGGs",
      "type": "text",
      "x": 3361.462166373029,
      "y": 1210.0698531490948,
      "width": 925.382366407579,
      "height": 334.1330946287453,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0a",
      "roundness": null,
      "seed": 243641804,
      "version": 4074,
      "versionNonce": 385120534,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792671791381,
      "link": null,
      "locked": false,
      "text": "- values are stored contigously\n- append-only\n- link, chain strucutre is decoupled, in another file (index like strucutre)\n- this has some benifits\n    + no in-place updates\n    + append only addition\n    + decouples values storage, from their view\n    + kinda like postgres heap file\n    + we access it as a list via ListIndex\n    + can access it with another view via another External Index\n    + kinda like visitor pattern, indexes => views are external to value storage",
      "fontSize": 24.30058870027239,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- values are stored contigously\n- append-only\n- link, chain strucutre is decoupled, in another file (index like strucutre)\n- this has some benifits\n    + no in-place updates\n    + append only addition\n    + decouples values storage, from their view\n    + kinda like postgres heap file\n    + we access it as a list via ListIndex\n    + can access it with another view via another External Index\n    + kinda like visitor pattern, indexes => views are external to value storage",
      "autoResize": false,
      "lineHeight": 1.25
    },
