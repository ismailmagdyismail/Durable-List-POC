      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* Stores Logical Inserts / Updates, NOT PHYSICAL DISK Changes\n+ this Decouples it from underlying storage format\n+ eliminate Disk, Cache access",
      "autoResize": false,
      "lineHeight": 1.25
    },
